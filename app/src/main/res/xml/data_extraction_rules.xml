<?xml version="1.0" encoding="utf-8"?>
<!-- Credentials are Keystore-bound (undecryptable after restore) and models are huge: keep both
     out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="harness_settings.xml"/>
        <exclude domain="file" path="models/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="harness_settings.xml"/>
        <exclude domain="file" path="models/"/>
    </device-transfer>
</data-extraction-rules>